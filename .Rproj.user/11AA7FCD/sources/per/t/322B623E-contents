#Operators
#Arithmetic Operators----
a<- 12
b<- 10
# print(a+b)
paste("Addition: ",a+b)
paste("Subtraction: ",a-b)
paste("Multiplication: ",a*b)
paste("Division: ",a/b)
paste("Power: ",a^b)
paste("Remainder: ",a%%b)
paste("Quotient: ",a%/%b)

# Relational Operators----
paste("Is a greater than b? ", a>b)
paste("Is a less than b? ",a<b)
