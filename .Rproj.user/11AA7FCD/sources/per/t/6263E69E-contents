#Functions----
# Built in functions----
numbers<- c(23,54,77,92,56,12,29,60)
total = sum(numbers)   #sum
average = mean(numbers)  #average
LowestValue = min(numbers) #Minimum Value
HighestValue = max(numbers) #Maximum Values
Length = length(numbers)
ApproxValue = round(12.568903, 2)


cat("Given Numbers: ",numbers)
cat("Sum of given Numbers: ",total)
cat("Average of given Numbers: ",average)
cat("Lowest Value: ",LowestValue)
cat("Highest Value: ",HighestValue)
cat("Length: ",Length)
cat("Round off: ",ApproxValue)
# Custom Functions----
# Function with Argument
square <- function(x){
  return (x * x)
}
square(4)
# square()

#function with default argument

cube <- function(x = 2){
  return (x * x * x)
}
cube()
cube(3)