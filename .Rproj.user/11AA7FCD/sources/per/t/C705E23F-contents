#Lists(List can stores more elements with different data types and structures)----
Student = list(
  id = 121,
  name = "Abc",
  BatchCode = "2406C2",
  Courses = c("R Programming", "AI / ML", "Hadoop")
);
print(Student)
Student$Courses

#Matrices (multidimensional with same basic type)----
m <- matrix(
  # 1:6,
  c(23,56,43,78,78,44),
  nrow = 2,
  ncol = 3
)
print(m)
#Array (multidimensional collection of elements with same basic data type)----
arr <- array(
 1:12,
 dim = c(2,4,2)  #Row, Column, Layers
)
print(arr)

#Data Frames (is a tabular structures in which columns can contain different types of data but each row contain same number opf elements)----
Students <- data.frame(
  id = c(121,122,123,124),
  name = c("Abc","Xyz","Mno","Pqr"),
  batchCode = c("2406C2","2311B3","2307C1","2406C2")
)
print(Students)
Students$name
